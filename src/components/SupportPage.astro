---
import CommunityLayout from './CommunityLayout.astro';
import ShareButton from './ShareButton';
import { pageHref, type LangCode } from '../lib/i18n';
import { islandStrings } from '../lib/i18n/island';
import { SUPPORT_CARDS as cards } from '../lib/i18n/page-data';
import { trFor } from '../lib/i18n/loader';

/** The support page, in one language. */
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const tt = trFor(lang);
const english = lang === 'en' || lang === 'en-gb';
---

<CommunityLayout
  title={tt('Support iDuckCalculator: ways to help keep it free')}
  description={tt('iDuckCalculator is free to use, with no ads and no sign-up. Share it, send feedback or suggest a calculator to help it grow.')}
  {...(english ? { before: 'Keep it', mark: 'free' } : { heading: tt('Keep it free') })}
  intro={tt('iDuckCalculator costs nothing to use: no sign-up and no ads. Money is not the only way to help, and these all make a real difference.')}
>
  <section class="card p-5" aria-labelledby="share">
    <h2 id="share" class="text-2xl font-black tracking-tight">{tt('Tell someone')}</h2>
    <p class="mt-1 text-muted">{tt('The best thing you can do is pass it on to a friend, a classmate or a coworker who is wrestling with a calculation.')}</p>
    <div class="mt-4"><ShareButton client:load {...(english ? {} : { strings: islandStrings(lang, 'share')! })} /></div>
  </section>

  <section aria-labelledby="other">
    <h2 id="other" class="text-2xl font-black tracking-tight">{tt('Other ways to help')}</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        cards.map((c) => (
          <li>
            <a href={pageHref(lang, c.to)} class="card card-link h-full p-4">
              <span class="text-lg font-black"><span aria-hidden="true">{c.icon}</span> {tt(c.title)}</span>
              <span class="mt-1 block text-sm text-muted">{tt(c.text)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="card p-5">
    <h2 class="text-2xl font-black tracking-tight">{tt('Tips')}</h2>
    <p class="mt-1 text-muted">{tt('Tips are not open yet. When they are, this page will say so clearly, and nothing is collected before then.')}</p>
  </section>
</CommunityLayout>
