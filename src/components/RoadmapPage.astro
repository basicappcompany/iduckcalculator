---
import CommunityLayout from './CommunityLayout.astro';
import { CALCULATORS, calcPath, calcsInGroup, liveGroups } from '../lib/calc';
import { fill, localeOf, pageHref, type LangCode } from '../lib/i18n';
import { ROADMAP_LATER as later, ROADMAP_NEXT as next } from '../lib/i18n/page-data';
import { trFor } from '../lib/i18n/loader';

/** The roadmap, in one language. */
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const tt = trFor(lang);
const groupNames = localeOf(lang).groups;
const href = (key: string) => pageHref(lang, key);
const groups = liveGroups();
const english = lang === 'en' || lang === 'en-gb';
const missing = fill(tt('Missing something? {request}.'), { request: `<a class="link" href="${pageHref(lang, '/request/')}">${tt('Request a calculator')}</a>` });
---

<CommunityLayout
  title={tt('Roadmap: what is live and what is next | iDuckCalculator')}
  description={tt('See every iDuckCalculator calculator that is live today and what we are building next, including the India tax and savings scheme calculators.')}
  {...(english ? { before: "What's", mark: 'next' } : { heading: tt("What's next") })}
  intro={tt('Everything that is live, and what we are thinking about. This list is kept honest: if it is under Live, you can open it now.')}
>
  <section aria-labelledby="live">
    <h2 id="live" class="text-2xl font-black tracking-tight">{fill(tt('Live now ({n})'), { n: CALCULATORS.length })}</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      {
        groups.map((g) => (
          <div class="card p-4">
            <h3 class="text-lg font-black">{g.emoji} {groupNames[g.id]}</h3>
            <ul class="mt-2 grid gap-1 text-sm">
              {calcsInGroup(g.id).map((c) => (
                <li>✅ <a class="link" href={href(calcPath(c.slug))}>{tt(c.name)}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="next">
    <h2 id="next" class="text-2xl font-black tracking-tight">{tt('Next')}</h2>
    <ul class="mt-3 grid gap-3">
      {
        next.map((n) => (
          <li class="card p-4">
            <span class="font-black">🔜 {tt(n.name)}</span>
            <span class="mt-1 block text-sm text-muted">{tt(n.note)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="later">
    <h2 id="later" class="text-2xl font-black tracking-tight">{tt('Later')}</h2>
    <ul class="mt-3 grid gap-2">
      {later.map((l) => <li class="card p-3 text-sm">💭 {tt(l)}</li>)}
    </ul>
    <p class="mt-4 text-sm text-muted" set:html={missing} />
  </section>
</CommunityLayout>
