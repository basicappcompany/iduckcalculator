---
import AppShell from './AppShell.astro';
import { CALCULATORS, calcPath, calcsInGroup, liveGroups } from '../lib/calc';
import { breadcrumbLd, collectionLd } from '../lib/seo';
import { fill, localeOf, localePath, pageHref, type LangCode } from '../lib/i18n';
import { trFor } from '../lib/i18n/loader';

/** The page that lists every calculator, in one language. */
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const tt = trFor(lang);
const chrome = localeOf(lang).chrome;
const groupNames = localeOf(lang).groups;
const href = (key: string) => pageHref(lang, key);
const groups = liveGroups();
const items = CALCULATORS.map((c) => ({ name: tt(c.name), path: href(calcPath(c.slug)) }));
const total = CALCULATORS.length;
---

<AppShell
  title={tt('All calculators: loans, savings, maths, dates, health | iDuckCalculator')}
  description={fill(tt('Browse all {n} free calculators: EMI and loans, SIP and savings, percentage and everyday maths, dates, health and student tools.'), { n: total })}
  jsonLd={[collectionLd(chrome.all, href('/calculators/'), tt('Every free calculator on iDuckCalculator.'), items), breadcrumbLd([{ name: chrome.home, path: localePath(lang, '/') }, { name: chrome.all, path: href('/calculators/') }])]}
>
  <h1 class="display text-4xl sm:text-5xl">{chrome.all} <span class="mark">{total}</span></h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">{tt('Every calculator, by group. Results update as you type, and nothing leaves your browser.')}</p>
  <nav class="mt-5 flex flex-wrap gap-2" aria-label={tt('Jump to a group')}>
    {groups.map((g) => <a class="chip" href={`#${g.id}`}>{g.emoji} {groupNames[g.id]}</a>)}
  </nav>
  {
    groups.map((g) => (
      <section class="mt-10" id={g.id} aria-label={groupNames[g.id]}>
        <h2 class="text-2xl font-black tracking-tight">{g.emoji} {groupNames[g.id]}</h2>
        {g.id === 'tax' && <p class="mt-1 text-sm"><a class="link" href={href('/tax/')}>{tt('Tax and salary calculators by country')}</a></p>}
        <ul class="card-grid mt-3">
          {calcsInGroup(g.id).map((c) => (
            <li>
              <a href={href(calcPath(c.slug))} class="card card-link h-full p-4">
                <span class="flex items-center gap-2.5 text-[17px] font-black">
                  <span aria-hidden="true" class="text-[28px] leading-none">{c.emoji}</span>
                  {tt(c.name)}
                </span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{tt(c.summary)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</AppShell>
