---
import { DISCLAIMER, LAST_REVIEWED, type Trust } from '../lib/calc/sources';

interface Props {
  trust: Trust;
  /** The date shown as "Last reviewed". */
  reviewed?: string;
}
const { trust, reviewed = LAST_REVIEWED } = Astro.props;
const date = new Date(`${reviewed}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<aside class="trust card mt-6 p-4 text-sm" aria-label="How this was checked">
  <p>
    <b>Last reviewed:</b> <time datetime={reviewed}>{date}</time>. <b>Where the maths comes from:</b> {trust.basis}
    {
      trust.sources.length > 0 && (
        <>
          {' '}Formula reference:{' '}
          {trust.sources.map((s, i) => (
            <>
              {i > 0 && ', '}
              <a class="link" href={s.url} rel="noopener">{s.name}</a>
            </>
          ))}
          .
        </>
      )
    }
  </p>
  <p class="mt-2 text-muted">{DISCLAIMER[trust.kind]} <a class="link" href="/how-we-check/">How we check our calculators</a>.</p>
</aside>
