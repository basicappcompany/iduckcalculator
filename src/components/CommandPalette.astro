---
/**
 * The Ctrl K search window: a dim backdrop, a thick-bordered card
 * with a hard shadow, results grouped as Calculators, Pages and Actions, the selected row in
 * duck yellow, and a hint bar. Opens with Ctrl K or Cmd K (toggles), with "/" when you are not
 * typing, and from the Search button. Arrow keys move, Enter opens, Esc closes.
 */
interface Props {
  placeholder: string;
  label: string;
  title: string;
  /** Where the list of calculators, guides and pages comes from: /palette/<lang>.json, fetched the first time the window opens. */
  src: string;
  /** The words under the list: arrow keys move, Enter opens, Esc closes. */
  hints: { move: string; open: string; close: string };
  results: string;
}
const { placeholder, label, title, src, hints, results } = Astro.props;
---

<div id="palette" class="palette" hidden data-src={src}>
  <div class="palette-backdrop" data-palette-close></div>
  <div class="palette-card" role="dialog" aria-modal="true" aria-label={title}>
    <div class="palette-top">
      <span aria-hidden="true" class="text-lg">🔍</span>
      <input
        id="palette-input"
        type="text"
        class="palette-input"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label={label}
      />
      <kbd class="palette-kbd" aria-hidden="true">Esc</kbd>
    </div>
    <div id="palette-list" class="palette-list" role="listbox" aria-label={results}></div>
    <div class="palette-hints" aria-hidden="true">
      <span>↑ ↓ {hints.move}</span><span>Enter {hints.open}</span><span>Esc {hints.close}</span>
    </div>
  </div>
</div>

<style is:global>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 11vh 14px 0;
  }
  .palette[hidden] {
    display: none;
  }
  .palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }
  .palette-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--d-card);
    color: var(--d-ink);
    border: 3px solid var(--d-line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 8px 8px 0 #000;
  }
  .palette-top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 2px solid var(--d-line);
  }
  .palette-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    font-size: 18px;
    color: var(--d-ink);
  }
  .palette-input::placeholder {
    color: var(--d-muted);
  }
  .palette-kbd {
    border: 1.5px solid var(--d-muted);
    color: var(--d-muted);
    border-radius: 6px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 800;
  }
  .palette-list {
    max-height: min(420px, 60vh);
    overflow-y: auto;
    padding: 8px;
  }
  .palette-group {
    color: var(--d-muted);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 8px 10px 3px;
  }
  .palette-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--d-ink);
    text-align: left;
    cursor: pointer;
    font: inherit;
  }
  .palette-row[aria-selected='true'] {
    background: var(--d-duck);
    color: var(--d-duckink);
  }
  .palette-icon {
    width: 28px;
    text-align: center;
    font-size: 20px;
  }
  .palette-label {
    flex: 1;
    font-weight: 800;
    font-size: 15.5px;
  }
  .palette-hint {
    font-size: 12px;
    color: var(--d-muted);
  }
  .palette-row[aria-selected='true'] .palette-hint {
    color: var(--d-duckink);
  }
  .palette-empty {
    color: var(--d-muted);
    padding: 16px;
  }
  .palette-hints {
    display: flex;
    gap: 16px;
    justify-content: center;
    padding: 9px;
    border-top: 2px solid var(--d-line);
    color: var(--d-muted);
    font-size: 12px;
  }
</style>

<script>
  import { browserTheme } from '../lib/theme-client';

  interface Data {
    calcs: { s: string; n: string; e: string; k: string; h: string }[];
    pages: { to: string; label: string; icon: string; kw: string; hint: string }[];
    ui: { calculators: string; pages: string; actions: string; calculator: string; page: string; guide: string; guides: string; action: string; theme: string; empty: string; results: string };
  }
  interface Item {
    id: string;
    label: string;
    icon: string;
    hint: string;
    group: string;
    run: () => void;
  }

  const root = document.getElementById('palette') as HTMLElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const list = document.getElementById('palette-list') as HTMLElement;
  const MAX = 14;

  const go = (href: string) => () => {
    location.href = href;
  };

  // The list is a small JSON file for the page's language, fetched the first time the window opens.
  let data: Data | null = null;
  let loading: Promise<void> | null = null;
  function load(): Promise<void> {
    loading ??= fetch(root.dataset['src'] ?? '/palette/en.json')
      .then((r) => r.json() as Promise<Data>)
      .then((d) => {
        data = d;
      })
      .catch(() => {
        loading = null;
      });
    return loading;
  }

  // Words of any script: letters and digits, so "kredi", "ब्याज" and "кредит" all work.
  const words = (s: string) => s.toLowerCase().split(/[^\p{L}\p{N}]+/u).filter(Boolean);
  const matches = (query: string, text: string) => {
    const q = words(query);
    if (q.length === 0) return true;
    const hay = words(text);
    return q.every((w) => hay.some((h) => h.startsWith(w)));
  };

  const theme = browserTheme();

  function build(query: string): Item[] {
    const d = data;
    if (!d) return [];
    const q = query.trim();
    const qw = words(q);
    const found = q
      ? d.calcs
          .map((c) => {
            if (!matches(q, c.n + ' ' + c.k)) return null;
            const name = c.n.toLowerCase();
            return { c, score: qw.reduce((t, w) => t + (name.startsWith(w) ? 3 : name.includes(w) ? 2 : 1), 0) };
          })
          .filter((x): x is { c: Data['calcs'][number]; score: number } => !!x)
          .sort((a, b) => b.score - a.score)
          .map((x) => x.c)
      : d.calcs.slice(0, 8);
    const calcs: Item[] = found.map((c) => ({ id: 'c-' + c.s, label: c.n, icon: c.e, hint: d.ui.calculator, group: d.ui.calculators, run: go(c.h) }));
    const pages: Item[] = d.pages.filter((p) => matches(q, p.label + ' ' + p.kw)).map((p) => ({ id: 'p-' + p.to, label: p.label, icon: p.icon, hint: p.hint, group: d.ui.pages, run: go(p.to) }));
    const actions: Item[] = matches(q, d.ui.theme + ' switch light dark theme mode night')
      ? [{ id: 'a-theme', label: d.ui.theme, icon: '🌗', hint: d.ui.action, group: d.ui.actions, run: () => theme.toggle() }]
      : [];
    return [...calcs.slice(0, 10), ...pages, ...actions].slice(0, MAX);
  }

  let items: Item[] = [];
  let sel = 0;
  let opener: HTMLElement | null = null;

  const rowId = (i: number) => `palette-row-${i}`;

  function render() {
    list.replaceChildren();
    if (items.length === 0) {
      const p = document.createElement('p');
      p.className = 'palette-empty';
      p.textContent = (data?.ui.empty ?? '').replace('{0}', input.value.trim());
      list.append(p);
      input.removeAttribute('aria-activedescendant');
      return;
    }
    let last = '';
    items.forEach((it, i) => {
      if (it.group !== last) {
        const h = document.createElement('div');
        h.className = 'palette-group';
        h.textContent = it.group;
        list.append(h);
        last = it.group;
      }
      const row = document.createElement('button');
      row.type = 'button';
      row.id = rowId(i);
      row.className = 'palette-row';
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', String(i === sel));
      row.tabIndex = -1;
      const icon = document.createElement('span');
      icon.className = 'palette-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = it.icon;
      const label = document.createElement('span');
      label.className = 'palette-label';
      label.textContent = it.label;
      const hint = document.createElement('span');
      hint.className = 'palette-hint';
      hint.textContent = it.hint;
      row.append(icon, label, hint);
      row.addEventListener('mouseenter', () => select(i, false));
      row.addEventListener('click', () => choose(i));
      list.append(row);
    });
    input.setAttribute('aria-activedescendant', rowId(sel));
  }

  function select(i: number, scroll = true) {
    if (i === sel || items.length === 0) return;
    sel = i;
    list.querySelectorAll('.palette-row').forEach((r, idx) => r.setAttribute('aria-selected', String(idx === sel)));
    input.setAttribute('aria-activedescendant', rowId(sel));
    if (scroll) document.getElementById(rowId(sel))?.scrollIntoView({ block: 'nearest' });
  }

  function choose(i: number) {
    const item = items[i];
    if (!item) return;
    close();
    item.run();
  }

  function refresh() {
    items = build(input.value);
    sel = 0;
    render();
  }

  function open() {
    if (!root.hidden) return;
    opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    refresh();
    input.focus();
    void load().then(refresh);
  }

  function close() {
    if (root.hidden) return;
    root.hidden = true;
    document.body.style.overflow = '';
    opener?.focus?.();
  }

  root.querySelectorAll('[data-palette-close]').forEach((el) => el.addEventListener('click', close));
  input.addEventListener('input', refresh);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      select(Math.min(items.length - 1, sel + 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      select(Math.max(0, sel - 1));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      choose(sel);
    } else if (e.key === 'Tab') {
      e.preventDefault(); // keep focus in the box while the window is open
    }
  });

  document.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    const el = e.target as HTMLElement | null;
    const typing = !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable);
    if ((e.ctrlKey || e.metaKey) && key === 'k') {
      e.preventDefault();
      if (root.hidden) open();
      else close();
    } else if (key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      open();
    } else if (key === 'escape' && !root.hidden) {
      e.preventDefault();
      close();
    }
  });

  document.getElementById('search-open')?.addEventListener('click', open);
</script>
