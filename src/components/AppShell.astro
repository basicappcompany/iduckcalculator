---
import '../styles/global.css';
import DuckMark from './DuckMark.astro';
import CommandPalette from './CommandPalette.astro';
import { calcPath, calcsInGroup, liveGroups } from '../lib/calc';
import { THEME_STORAGE_KEY } from '../lib/theme';
import { COMMUNITY, communityPath } from '../lib/community';
import { LAST_UPDATED, OG_IMAGE, SITE_NAME, serialize } from '../lib/seo';
import { flagSvg } from '../lib/flags';
import { EN, LANGUAGES } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** For pages that must stay out of search results, such as the 404 page. */
  noindex?: boolean;
  /** Structured data objects (schema.org), written as JSON-LD in the head. */
  jsonLd?: unknown[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isHome = path === '/';
const groups = liveGroups();
// The group holding the current page starts open; on any other page the first group does.
const openGroup = groups.find((g) => calcsInGroup(g.id).some((c) => calcPath(c.slug) === path))?.id ?? groups[0]?.id;
const t = EN;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fffdf5" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="iDuckCalculator: free calculators with a duck mascot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={serialize(item)} />)}
    <!-- Runs before first paint, so a visitor who chose dark mode never sees a flash of light. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        const saved = localStorage.getItem(key);
        if (saved === 'dark' || saved === 'light') document.documentElement.setAttribute('data-theme', saved);
      } catch {
        // Storage can be blocked (private mode); the system setting then applies.
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      data-i18n="skip"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:border-2 focus:border-line focus:bg-duck focus:px-4 focus:py-2 focus:font-black focus:text-duckink"
    >
      {t.skip}
    </a>

    <div class="shell">
      <aside class="sidebar" id="sidebar" aria-label="Site menu">
        <div class="nav-scroll">
          <a href="/" class="nav-brand" aria-label="iDuckCalculator home">
            <DuckMark size={34} />
            <span>iDuckCalculator</span>
          </a>

          <button type="button" id="sidebar-search" class="nav-search" aria-label={t.searchAria} data-i18n-aria="searchAria">
            <span aria-hidden="true">🔍</span>
            <span class="flex-1 text-left" data-i18n="searchPlaceholder">{t.searchPlaceholder}</span>
            <kbd aria-hidden="true">Ctrl K</kbd>
          </button>

          <nav aria-label="Main">
            <a class="nav-item" href="/" aria-current={isHome ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🏠</span><span class="nav-text" data-i18n="home">{t.home}</span>
            </a>
            <a class="nav-item" href="/chat/" aria-current={path === '/chat/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">💬</span><span class="nav-text" data-i18n="helper">{t.helper}</span>
            </a>
            <a class="nav-item" href="/calculators/" aria-current={path === '/calculators/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🧮</span><span class="nav-text" data-i18n="all">{t.all}</span>
            </a>
            <a class="nav-item" href="/guides/" aria-current={path.startsWith('/guides/') ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">📖</span><span class="nav-text" data-i18n="guides">{t.guides}</span>
            </a>
          </nav>

          <nav aria-label="Calculators">
            <p class="nav-label" data-i18n="calculators">{t.calculators}</p>
            {
              groups.map((group, i) => {
                const open = group.id === openGroup;
                return (
                  <div data-group>
                    <button type="button" class="nav-group" data-nav-group aria-expanded={open ? 'true' : 'false'} aria-controls={`group-${i}`}>
                      <span class="nav-icon" aria-hidden="true">{group.emoji}</span>
                      <span class="nav-text">{group.name}</span>
                      <span class="nav-chevron" aria-hidden="true">›</span>
                    </button>
                    <ul class="nav-children" id={`group-${i}`} hidden={!open}>
                      {calcsInGroup(group.id).map((c) => (
                        <li data-calc={c.slug}>
                          <a class="nav-item nav-small" href={calcPath(c.slug)} aria-current={path === calcPath(c.slug) ? 'page' : undefined}>
                            <span class="nav-icon" aria-hidden="true">{c.emoji}</span>
                            <span class="nav-text">{c.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })
            }
          </nav>

          <p class="nav-label" data-i18n="community">{t.community}</p>
          <ul>
            {
              COMMUNITY.map((page) => (
                <li>
                  <a class="nav-item" href={communityPath(page.slug)} aria-current={path === communityPath(page.slug) ? 'page' : undefined}>
                    <span class="nav-icon" aria-hidden="true">{page.emoji}</span>
                    <span class="nav-text">{page.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="nav-label" data-i18n="alsoFrom">{t.alsoFrom}</p>
          <a class="nav-item" href="https://iduckpdf.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">📚</span><span class="nav-text">iDuckPDF</span>
          </a>
          <a class="nav-item" href="https://iduckimg.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">🖼️</span><span class="nav-text">iDuckImg</span>
          </a>
        </div>
      </aside>

      <div class="scrim" data-menu-scrim></div>

      <div class="min-w-0">
        <header class="topbar sticky top-0 z-20 flex items-center gap-1.5 px-2.5 py-2 min-[400px]:gap-2 min-[400px]:px-3">
          <button type="button" class="btn btn-sm" data-menu-button aria-label={t.menu} data-i18n-aria="menu" aria-controls="sidebar" aria-expanded="false">☰</button>
          <a href="/" class="flex items-center gap-2 rounded-lg min-[900px]:hidden">
            <DuckMark size={28} />
            <span class="hidden font-black min-[460px]:inline">iDuckCalculator</span>
          </a>
          <div class="ml-auto flex items-center gap-1.5 min-[400px]:gap-2">
            <button type="button" class="btn btn-sm" id="search-open" aria-label={t.searchAria} data-i18n-aria="searchAria">
              <span aria-hidden="true">🔍</span>
              <span class="hidden sm:inline" data-i18n="search">{t.search}</span>
            </button>
            <details class="lang" data-lang-menu>
              <summary class="btn btn-sm" aria-label={t.language} data-i18n-aria="language">
                <span data-lang-flag><Fragment set:html={flagSvg('en')} /></span>
                <span class="hidden min-[520px]:inline" data-lang-name>English (US)</span>
              </summary>
              <ul class="lang-list">
                {
                  LANGUAGES.map((l) => (
                    <li>
                      <button type="button" data-lang={l.code} lang={l.hreflang} aria-current={l.code === 'en' ? 'true' : undefined} class="w-full text-left">
                        <Fragment set:html={flagSvg(l.code)} />
                        <span>{l.native}</span>
                      </button>
                    </li>
                  ))
                }
              </ul>
            </details>
            <button type="button" class="btn btn-sm" id="theme-toggle" aria-label={t.theme} data-i18n-aria="theme" aria-pressed="false">
              <span data-theme-icon="moon" aria-hidden="true">🌙</span>
              <span data-theme-icon="sun" aria-hidden="true">☀️</span>
            </button>
            <a href="/support/" class="btn btn-sm btn-primary" aria-label={t.support} data-i18n-aria="support">
              <span aria-hidden="true">💛</span>
              <span class="hidden min-[520px]:inline" data-i18n="support">{t.support}</span>
            </a>
          </div>
        </header>

        <main id="main" class="mx-auto w-full max-w-[1072px] px-4 py-8">
          <p class="mb-5 hidden text-sm font-bold" data-machine-note>{t.machine}</p>
          <slot />
        </main>

        <footer class="mx-auto max-w-[1072px] px-4 pb-10 text-sm text-muted">
          <div class="border-t-2 border-line pt-6">
            <p class="flex flex-wrap gap-x-4 gap-y-1">
              <a class="link" href="/calculators/" data-i18n="all">{t.all}</a>
              <a class="link" href="/guides/" data-i18n="guides">{t.guides}</a>
              <a class="link" href="/about/" data-i18n="about">{t.about}</a>
              <a class="link" href="/privacy/" data-i18n="privacy">{t.privacy}</a>
              <a class="link" href="/terms/" data-i18n="terms">{t.terms}</a>
              <a class="link" href="/feedback/" data-i18n="feedback">{t.feedback}</a>
            </p>
            <p class="mt-3">
              Also try <a class="link" href="https://iduckpdf.com/" rel="noopener">iDuckPDF</a> and <a class="link" href="https://iduckimg.com/" rel="noopener">iDuckImg</a>.
            </p>
            <p class="mt-3">
              © 2026 Basic App Company · iDuckCalculator · iduckcalculator.com · <span data-i18n="footerTagline">{t.footerTagline}</span> Last updated {LAST_UPDATED}.
            </p>
          </div>
        </footer>
      </div>
    </div>

    <CommandPalette />

    <script>
      import { THEME_STORAGE_KEY } from '../lib/theme';
      import { DICTS, LANGUAGES, LANG_STORAGE_KEY, type Dict } from '../lib/i18n';
      import { flagSvg } from '../lib/flags';

      const root = document.documentElement;
      const body = document.body;

      // ---- light / dark ----
      const toggle = document.getElementById('theme-toggle');
      const isDark = () =>
        root.getAttribute('data-theme') === 'dark' ||
        (root.getAttribute('data-theme') !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      const syncToggle = () => toggle?.setAttribute('aria-pressed', String(isDark()));
      syncToggle();
      window.addEventListener('duck-theme', syncToggle);
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem(THEME_STORAGE_KEY, next);
        } catch {
          // Private mode: the choice still applies for this visit.
        }
        syncToggle();
        window.dispatchEvent(new CustomEvent('duck-theme'));
      });

      // ---- language (page chrome only) ----
      const langMenu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
      function applyLang(code: string) {
        const lang = LANGUAGES.find((l) => l.code === code) ?? LANGUAGES[0]!;
        const dict: Dict = DICTS[lang.code];
        root.lang = lang.hreflang;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const v = dict[el.dataset['i18n'] as keyof Dict];
          if (v) el.textContent = v;
        });
        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
          const v = dict[el.dataset['i18nAria'] as keyof Dict];
          if (v) el.setAttribute('aria-label', v);
        });
        const flag = document.querySelector('[data-lang-flag]');
        if (flag) flag.innerHTML = flagSvg(lang.code);
        const name = document.querySelector('[data-lang-name]');
        if (name) name.textContent = lang.native;
        document.querySelectorAll<HTMLElement>('[data-lang]').forEach((b) => b.toggleAttribute('aria-current', b.dataset['lang'] === lang.code));
        const note = document.querySelector<HTMLElement>('[data-machine-note]');
        if (note) {
          note.hidden = lang.reviewed;
          note.classList.toggle('hidden', lang.reviewed);
          if (!lang.reviewed) note.textContent = dict.machine;
        }
        const input = document.getElementById('palette-input') as HTMLInputElement | null;
        if (input) input.placeholder = dict.searchPlaceholder;
      }
      let saved = 'en';
      try {
        saved = localStorage.getItem(LANG_STORAGE_KEY) ?? 'en';
      } catch {
        // Storage blocked: stay on English.
      }
      if (saved !== 'en') applyLang(saved);
      langMenu?.querySelectorAll<HTMLElement>('[data-lang]').forEach((b) =>
        b.addEventListener('click', () => {
          const code = b.dataset['lang'] ?? 'en';
          try {
            localStorage.setItem(LANG_STORAGE_KEY, code);
          } catch {
            // Private mode: the choice still applies for this visit.
          }
          applyLang(code);
          langMenu.open = false;
        }),
      );
      if (langMenu) {
        // The menu closes on a tap or click elsewhere ("pointerdown" covers touch; iOS sends no click for plain page taps), Escape, or focus leaving.
        document.addEventListener('pointerdown', (e) => {
          if (!langMenu.contains(e.target as Node)) langMenu.open = false;
        });
        langMenu.addEventListener('focusout', (e) => {
          const next = e.relatedTarget as Node | null;
          if (next && !langMenu.contains(next)) langMenu.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') langMenu.open = false;
        });
        window.addEventListener('pageshow', () => (langMenu.open = false));
      }

      // ---- phone menu ----
      const menuButton = document.querySelector<HTMLElement>('[data-menu-button]');
      const setMenu = (open: boolean) => {
        body.dataset['menu'] = open ? 'open' : 'closed';
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenu(body.dataset['menu'] !== 'open'));
      document.querySelector('[data-menu-scrim]')?.addEventListener('click', () => setMenu(false));
      document.querySelectorAll('#sidebar a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // ---- collapsible groups ----
      document.querySelectorAll<HTMLButtonElement>('[data-nav-group]').forEach((button) => {
        button.addEventListener('click', () => {
          const open = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(open));
          const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
          if (list) list.hidden = !open;
        });
      });

      // ---- search: the Ctrl K window lives in CommandPalette.astro ----
      document.getElementById('sidebar-search')?.addEventListener('click', () => {
        setMenu(false);
        document.getElementById('search-open')?.click();
      });
    </script>
  </body>
</html>
