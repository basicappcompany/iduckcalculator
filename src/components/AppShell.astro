---
import '../styles/global.css';
import DuckMark from './DuckMark.astro';
import CommandPalette from './CommandPalette.astro';
import { calcPath, calcsInGroup, liveGroups } from '../lib/calc';
import { THEME_STORAGE_KEY } from '../lib/theme';
import { COMMUNITY, communityPath } from '../lib/community';
import { LAST_UPDATED, OG_IMAGE, SITE_NAME, serialize } from '../lib/seo';
import { flagSvg } from '../lib/flags';
import { LANGUAGES, fill, langsFor, languageOf, localeOf, localePath, pageHref, splitLocale, switchHref } from '../lib/i18n';
import { trFor } from '../lib/i18n/loader';

interface Props {
  title: string;
  description: string;
  /** For pages that must stay out of search results, such as the 404 page. */
  noindex?: boolean;
  /** Structured data objects (schema.org), written as JSON-LD in the head. */
  jsonLd?: unknown[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// The language comes from the URL (/de/about/ is German); `key` is the same page's English path (/about/).
const { lang, key } = splitLocale(path);
const language = languageOf(lang);
const locale = localeOf(lang);
const t = locale.chrome;
const tt = trFor(lang);
const isHome = key === '/';
const groups = liveGroups();
// The group holding the current page starts open; on any other page the first group does.
const openGroup = groups.find((g) => calcsInGroup(g.id).some((c) => calcPath(c.slug) === key))?.id ?? groups[0]?.id;
const href = (k: string) => pageHref(lang, k);
const communityName: Record<string, string> = {
  roadmap: t.roadmap,
  request: t.request,
  feedback: t.feedback,
  support: t.supportFull,
  settings: t.settings,
  'how-we-check': t.howWeCheck,
  about: t.about,
};
// The same page in every language it exists in, for search engines. Pages in one language only, and pages that stay out of search results, carry none.
const alternates = noindex || langsFor(key).length < 2 ? [] : langsFor(key).map((code) => ({ hreflang: languageOf(code).hreflang, href: new URL(localePath(code, key), Astro.site).href }));
const alsoTry = fill(t.alsoTry, {
  pdf: '<a class="link" href="https://iduckpdf.com/" rel="noopener">iDuckPDF</a>',
  img: '<a class="link" href="https://iduckimg.com/" rel="noopener">iDuckIMG</a>',
  convert: '<a class="link" href="https://iduckconvert.com/" rel="noopener">iDuckConvert</a>',
});
// The brand goes after the title only when the whole <title> stays under 60 characters; search results cut longer ones.
const BRAND_SUFFIX = ' | iDuckCalculator';
const bareTitle = title.endsWith(BRAND_SUFFIX) ? title.slice(0, -BRAND_SUFFIX.length) : title;
const fullTitle = bareTitle.length + BRAND_SUFFIX.length <= 59 ? `${bareTitle}${BRAND_SUFFIX}` : bareTitle;
---

<!doctype html>
<html lang={language.hreflang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fffdf5" media="(prefers-color-scheme: light)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', key), Astro.site).href} />}
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:locale" content={language.ogLocale} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="iDuckCalculator: free calculators with a duck mascot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={serialize(item)} />)}
    <!-- Runs before first paint, so a visitor who chose dark mode never sees a flash of light. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        // Every page is light until the visitor changes it (the HTML already says so). A saved choice wins on every page:
        // light, dark, or "match my device", which removes the attribute so the system setting applies.
        const saved = localStorage.getItem(key);
        if (saved === 'dark' || saved === 'light') document.documentElement.setAttribute('data-theme', saved);
        else if (saved === 'system') document.documentElement.removeAttribute('data-theme');
      } catch {
        // Storage can be blocked (private mode); the page then keeps its default.
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:border-2 focus:border-line focus:bg-duck focus:px-4 focus:py-2 focus:font-black focus:text-duckink"
    >
      {t.skip}
    </a>

    <div class="shell">
      <aside class="sidebar" id="sidebar" aria-label={t.siteMenu}>
        <div class="nav-scroll">
          <a href={href('/')} class="nav-brand" aria-label={t.homeAria}>
            <DuckMark size={34} />
            <span>iDuckCalculator</span>
          </a>

          <button type="button" id="sidebar-search" class="nav-search" aria-label={t.searchAria}>
            <span aria-hidden="true">🔍</span>
            <span class="flex-1 text-left">{t.searchPlaceholder}</span>
            <kbd aria-hidden="true">Ctrl K</kbd>
          </button>

          <nav aria-label={t.mainNav}>
            <a class="nav-item" href={href('/')} aria-current={isHome ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🏠</span><span class="nav-text">{t.home}</span>
            </a>
            <a class="nav-item" href={href('/chat/')} aria-current={key === '/chat/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">💬</span><span class="nav-text">{t.helper}</span>
            </a>
            <a class="nav-item" href={href('/calculators/')} aria-current={key === '/calculators/' ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">🧮</span><span class="nav-text">{t.all}</span>
            </a>
            <a class="nav-item" href={href('/guides/')} aria-current={key.startsWith('/guides/') ? 'page' : undefined}>
              <span class="nav-icon" aria-hidden="true">📖</span><span class="nav-text">{t.guides}</span>
            </a>
          </nav>

          <nav aria-label={t.calculators}>
            <p class="nav-label">{t.calculators}</p>
            {
              groups.map((group, i) => {
                const open = group.id === openGroup;
                return (
                  <div data-group>
                    <button type="button" class="nav-group" data-nav-group aria-expanded={open ? 'true' : 'false'} aria-controls={`group-${i}`}>
                      <span class="nav-icon" aria-hidden="true">{group.emoji}</span>
                      <span class="nav-text">{locale.groups[group.id] ?? group.name}</span>
                      <span class="nav-chevron" aria-hidden="true">›</span>
                    </button>
                    <ul class="nav-children" id={`group-${i}`} hidden={!open}>
                      {calcsInGroup(group.id).map((c) => (
                        <li data-calc={c.slug}>
                          <a class="nav-item nav-small" href={href(calcPath(c.slug))} aria-current={key === calcPath(c.slug) ? 'page' : undefined}>
                            <span class="nav-icon" aria-hidden="true">{c.emoji}</span>
                            <span class="nav-text">{tt(c.name)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })
            }
          </nav>

          <p class="nav-label">{t.community}</p>
          <ul>
            {
              COMMUNITY.map((page) => (
                <li>
                  <a class="nav-item" href={href(communityPath(page.slug))} aria-current={key === communityPath(page.slug) ? 'page' : undefined}>
                    <span class="nav-icon" aria-hidden="true">{page.emoji}</span>
                    <span class="nav-text">{communityName[page.slug] ?? page.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="nav-label">{t.alsoFrom}</p>
          <a class="nav-item" href="https://iduckpdf.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">📚</span><span class="nav-text">iDuckPDF</span>
          </a>
          <a class="nav-item" href="https://iduckimg.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">🖼️</span><span class="nav-text">iDuckIMG</span>
          </a>
          <a class="nav-item" href="https://iduckconvert.com/" rel="noopener">
            <span class="nav-icon" aria-hidden="true">🔄</span><span class="nav-text">iDuckConvert</span>
          </a>
        </div>
      </aside>

      <div class="scrim" data-menu-scrim></div>

      <div class="min-w-0">
        <header class="topbar sticky top-0 z-20 flex items-center gap-1.5 px-2.5 py-2 min-[400px]:gap-2 min-[400px]:px-3">
          <button type="button" class="btn btn-sm" data-menu-button aria-label={t.menu} aria-controls="sidebar" aria-expanded="false">☰</button>
          <a href={href('/')} class="flex items-center gap-2 rounded-lg min-[900px]:hidden">
            <DuckMark size={28} />
            <span class="hidden font-black min-[460px]:inline">iDuckCalculator</span>
          </a>
          <div class="ml-auto flex items-center gap-1.5 min-[400px]:gap-2">
            <button type="button" class="btn btn-sm" id="search-open" aria-label={t.searchAria}>
              <span aria-hidden="true">🔍</span>
              <span class="hidden sm:inline">{t.search}</span>
            </button>
            <details class="lang" data-lang-menu>
              <summary class="btn btn-sm" aria-label={t.language}>
                <span data-lang-flag><Fragment set:html={flagSvg(language.flag)} /></span>
                <span class="hidden min-[520px]:inline" data-lang-name>{language.native}</span>
              </summary>
              <ul class="lang-list">
                {
                  LANGUAGES.map((l) => (
                    <li>
                      <a href={switchHref(l.code, key)} data-lang={l.code} lang={l.hreflang} hreflang={l.hreflang} aria-current={l.code === lang ? 'true' : undefined}>
                        <Fragment set:html={flagSvg(l.flag)} />
                        <span>{l.native}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
            <button type="button" class="btn btn-sm" id="theme-toggle" aria-label={t.theme} aria-pressed="false">
              <span data-theme-icon="moon" aria-hidden="true">🌙</span>
              <span data-theme-icon="sun" aria-hidden="true">☀️</span>
            </button>
            <a href={href('/support/')} class="btn btn-sm btn-primary" aria-label={t.support}>
              <span aria-hidden="true">💛</span>
              <span class="hidden min-[520px]:inline">{t.support}</span>
            </a>
          </div>
        </header>

        <main id="main" class="mx-auto w-full max-w-[1072px] px-4 py-8">
          {!language.reviewed && <p class="mb-5 text-sm font-bold" data-machine-note>{t.machine}</p>}
          <slot />
        </main>

        <footer class="mx-auto max-w-[1072px] px-4 pb-10 text-sm text-muted">
          <div class="border-t-2 border-line pt-6">
            <p class="flex flex-wrap gap-x-4 gap-y-1">
              <a class="link" href={href('/calculators/')}>{t.all}</a>
              <a class="link" href={href('/guides/')}>{t.guides}</a>
              <a class="link" href={href('/about/')}>{t.about}</a>
              <a class="link" href={href('/privacy/')}>{t.privacy}</a>
              <a class="link" href={href('/terms/')}>{t.terms}</a>
              <a class="link" href={href('/feedback/')}>{t.feedback}</a>
            </p>
            <p class="mt-3" set:html={alsoTry} />
            <p class="mt-3">
              © 2026 Basic App Company · iDuckCalculator · iduckcalculator.com · <span>{t.footerTagline}</span> {fill(t.lastUpdated, { date: LAST_UPDATED })}
            </p>
          </div>
        </footer>
      </div>
    </div>

    <CommandPalette placeholder={`${t.searchAria}…`} label={t.searchAria} title={t.search} src={`/palette/${lang}.json`} hints={{ move: tt('move'), open: tt('open'), close: tt('close') }} results={tt('Results')} />

    <script>
      import { THEME_STORAGE_KEY } from '../lib/theme';

      const root = document.documentElement;
      const body = document.body;

      // ---- light / dark ----
      const toggle = document.getElementById('theme-toggle');
      const isDark = () =>
        root.getAttribute('data-theme') === 'dark' ||
        (root.getAttribute('data-theme') !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      const syncToggle = () => toggle?.setAttribute('aria-pressed', String(isDark()));
      syncToggle();
      window.addEventListener('duck-theme', syncToggle);
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem(THEME_STORAGE_KEY, next);
        } catch {
          // Private mode: the choice still applies for this visit.
        }
        syncToggle();
        window.dispatchEvent(new CustomEvent('duck-theme'));
      });

      // ---- language menu: plain links to the other languages; this only closes it ----
      const langMenu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
      if (langMenu) {
        // The menu closes on a tap or click elsewhere ("pointerdown" covers touch; iOS sends no click for plain page taps), Escape, or focus leaving.
        document.addEventListener('pointerdown', (e) => {
          if (!langMenu.contains(e.target as Node)) langMenu.open = false;
        });
        langMenu.addEventListener('focusout', (e) => {
          const next = e.relatedTarget as Node | null;
          if (next && !langMenu.contains(next)) langMenu.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') langMenu.open = false;
        });
        window.addEventListener('pageshow', () => (langMenu.open = false));
      }

      // ---- phone menu ----
      const menuButton = document.querySelector<HTMLElement>('[data-menu-button]');
      const setMenu = (open: boolean) => {
        body.dataset['menu'] = open ? 'open' : 'closed';
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenu(body.dataset['menu'] !== 'open'));
      document.querySelector('[data-menu-scrim]')?.addEventListener('click', () => setMenu(false));
      document.querySelectorAll('#sidebar a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') setMenu(false);
      });

      // ---- collapsible groups ----
      document.querySelectorAll<HTMLButtonElement>('[data-nav-group]').forEach((button) => {
        button.addEventListener('click', () => {
          const open = button.getAttribute('aria-expanded') !== 'true';
          button.setAttribute('aria-expanded', String(open));
          const list = document.getElementById(button.getAttribute('aria-controls') ?? '');
          if (list) list.hidden = !open;
        });
      });

      // ---- search: the Ctrl K window lives in CommandPalette.astro ----
      document.getElementById('sidebar-search')?.addEventListener('click', () => {
        setMenu(false);
        document.getElementById('search-open')?.click();
      });
    </script>
  </body>
</html>
