---
import AppShell from './AppShell.astro';
import DuckMark from './DuckMark.astro';
import { CALCULATORS, calcPath, calcsInGroup, liveGroups, popularCalcs } from '../lib/calc';
import { GUIDES, guideBySlug, guidePath } from '../lib/guides';
import { faqLd, organizationLd, websiteLd } from '../lib/seo';
import { fill, languageOf, localeOf, pageHref, type LangCode } from '../lib/i18n';

/** The home page, in one language. src/pages/index.astro renders it in English and src/pages/[lang]/index.astro in the others. */
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const language = languageOf(lang);
const { chrome: c, groups: groupNames, home: h } = localeOf(lang);

const total = CALCULATORS.length;
const groups = liveGroups();
const faqs = h.faqs.map((f) => ({ q: f.q, a: fill(f.a, { total }) }));

// Six guides on the home page; the rest are on the guides page. Guide texts are translated in a later stage.
const FEATURED_GUIDES = ['how-emi-is-calculated', 'sip-vs-lumpsum', 'how-to-calculate-percentage', 'how-to-calculate-your-age', 'how-to-calculate-bmi', 'how-to-convert-cgpa-to-percentage']
  .map(guideBySlug)
  .filter((g): g is NonNullable<typeof g> => !!g);

const link = (key: string, text: string) => `<a class="link" href="${pageHref(lang, key)}">${text}</a>`;
const nextLinks = fill(h.nextLinks, { roadmap: link('/roadmap/', h.nextRoadmap), request: link('/request/', h.nextRequest) });
---

<AppShell
  jsonLd={[websiteLd(language.hreflang, h.description), organizationLd(), faqLd(faqs)]}
  title={h.title}
  description={h.description}
>
  <section class="text-center">
    <DuckMark size={96} class="mx-auto" />
    <h1 class="display mt-4 text-4xl min-[420px]:text-5xl sm:text-6xl">{h.h1Before}<span class="mark">{h.h1Mark}</span>{h.h1After}</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{fill(h.intro, { total })}</p>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <span class="pill pill-ok">{c.runs}</span>
      <span class="pill">{c.noSignup}</span>
      <span class="pill">{c.noAds}</span>
    </div>

    <div class="mx-auto mt-6 max-w-xl">
      <button type="button" id="hero-search" class="hero-search" aria-label={c.searchAria} data-open-palette>
        <span aria-hidden="true" class="text-lg">🔍</span>
        <span class="min-w-0 flex-1 truncate text-left">{c.searchPlaceholder}</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
      <p class="mt-2 text-sm text-muted" data-kbd-hint set:html={h.kbdHint} />
    </div>
  </section>

  <section class="mt-8" aria-label={c.helper}>
    <div class="card flex flex-wrap items-center gap-4 bg-duck p-5 text-duckink">
      <span aria-hidden="true" class="text-4xl">💬</span>
      <div class="min-w-48 flex-1">
        <h2 class="text-xl font-black tracking-tight">{h.helperTitle}</h2>
        <p class="opacity-80">{h.helperText}</p>
      </div>
      <a href={pageHref(lang, '/chat/')} class="btn btn-ink">{c.helper}</a>
    </div>
  </section>

  <section class="mt-10" aria-label={h.popular}>
    <h2 class="text-2xl font-black tracking-tight">{h.popular}</h2>
    <ul class="card-grid mt-3">
      {
        popularCalcs().map((calc) => (
          <li>
            <a href={calcPath(calc.slug)} class="card card-link h-full p-4">
              <span class="flex items-center gap-2.5 text-[17px] font-black">
                <span aria-hidden="true" class="text-[28px] leading-none">{calc.emoji}</span>
                {calc.name}
              </span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{calc.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" aria-label={c.all}>
    <h2 class="text-2xl font-black tracking-tight">{fill(h.allTitle, { total })}</h2>
    <p class="mt-1 text-muted">{h.allHint}</p>
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={h.filterAria}>
      <button type="button" class="chip" role="switch" aria-checked="true" data-filter="all">{fill(h.everything, { n: total })}</button>
      {
        groups.map((g) => (
          <button type="button" class="chip" role="switch" aria-checked="false" data-filter={g.id}>
            {g.emoji} {groupNames[g.id]} ({calcsInGroup(g.id).length})
          </button>
        ))
      }
    </div>
    <div class="mt-6">
      {
        groups.map((g) => (
          <div class="mt-8 first:mt-0" data-card-group data-group={g.id}>
            <h3 class="text-2xl font-black tracking-tight">{g.emoji} {groupNames[g.id]}</h3>
            <ul class="card-grid mt-3">
              {calcsInGroup(g.id).map((calc) => (
                <li data-card data-slug={calc.slug}>
                  <a href={calcPath(calc.slug)} class="card card-link h-full p-4">
                    <span class="flex items-center gap-2.5 text-[17px] font-black">
                      <span aria-hidden="true" class="text-[28px] leading-none">{calc.emoji}</span>
                      {calc.name}
                    </span>
                    <span class="mt-1 block text-sm leading-[19px] text-muted">{calc.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-14" aria-label={h.nextTitle}>
    <h2 class="text-3xl font-black tracking-tight">{h.nextTitle}</h2>
    <p class="mt-1 text-muted">{h.nextText}</p>
    <ul class="card-grid mt-3">
      {
        h.next.map((item) => (
          <li class="card p-4">
            <span class="flex items-center gap-2.5 text-[17px] font-black">
              <span aria-hidden="true" class="text-[28px] leading-none">{item.emoji}</span>
              {item.title}
            </span>
            <span class="mt-1 block text-sm leading-[19px] text-muted">{item.text}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm" set:html={nextLinks} />
  </section>

  <section class="mt-14" aria-label="iDuckCalculator">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        h.why.map((item) => (
          <li class="card p-4">
            <span aria-hidden="true" class="text-[28px] leading-none">{item.emoji}</span>
            <h3 class="mt-2 text-lg font-black">{item.title}</h3>
            <p class="mt-1 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14" aria-label={h.guidesTitle}>
    <h2 class="text-3xl font-black tracking-tight">{h.guidesTitle}</h2>
    <p class="mt-1 text-muted">{h.guidesText}</p>
    <ul class="card-grid mt-3">
      {
        FEATURED_GUIDES.map((g) => (
          <li>
            <a href={guidePath(g.slug)} class="card card-link h-full p-4">
              <span class="block text-[17px] font-black">{g.title}</span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{g.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3"><a class="link" href={pageHref(lang, '/guides/')}>{fill(h.allGuides, { n: GUIDES.length })}</a></p>
  </section>

  <section class="mt-14" aria-label={h.faqTitle}>
    <h2 class="text-3xl font-black tracking-tight">{h.faqTitle}</h2>
    <div class="mt-4 grid gap-3">
      {
        faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mt-14" aria-label={c.support}>
    <div class="card flex flex-wrap items-center gap-4 p-5">
      <span aria-hidden="true" class="text-4xl">💛</span>
      <div class="min-w-48 flex-1">
        <h2 class="text-xl font-black tracking-tight">{h.supportTitle}</h2>
        <p class="text-muted">{h.supportText}</p>
      </div>
      <a href={pageHref(lang, '/support/')} class="btn btn-primary">{h.supportButton}</a>
    </div>
  </section>

  <script>
    // The big search box is a button for the Ctrl K window, which lives in the page shell.
    document.querySelectorAll('[data-open-palette]').forEach((el) => el.addEventListener('click', () => document.getElementById('search-open')?.click()));

    // Group chips narrow the list of calculators; "Everything" shows all of them again.
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const wanted = chip.dataset['filter'] ?? 'all';
        chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
        document.querySelectorAll<HTMLElement>('[data-card-group]').forEach((g) => {
          g.hidden = wanted !== 'all' && g.dataset['group'] !== wanted;
        });
      }),
    );
  </script>
</AppShell>
