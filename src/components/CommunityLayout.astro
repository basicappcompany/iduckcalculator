---
import AppShell from './AppShell.astro';

interface Props {
  title: string;
  description: string;
  /** The heading is `before` + a highlighted `mark` + `after`, like the home page. */
  before?: string;
  mark?: string;
  after?: string;
  /** A whole heading (other languages): its last word is highlighted. */
  heading?: string;
  intro: string;
  noindex?: boolean;
  jsonLd?: unknown[];
}
const { title, description, heading, noindex = false, intro, jsonLd = [] } = Astro.props;
const words = heading?.trim().split(/\s+/) ?? [];
const before = heading ? words.slice(0, -1).join(' ') : (Astro.props.before ?? '');
const mark = heading ? (words[words.length - 1] ?? '') : (Astro.props.mark ?? '');
const after = heading ? '' : (Astro.props.after ?? '');
---

<AppShell title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <h1 class="display text-4xl sm:text-5xl">
    {before}{before && ' '}<span class="mark">{mark}</span>{after}
  </h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">{intro}</p>
  <div class="mt-6 grid gap-5">
    <slot />
  </div>
</AppShell>
