---
import CommunityLayout from './CommunityLayout.astro';
import { CALCULATORS } from '../lib/calc';
import { CONTACT_EMAIL } from '../lib/contact';
import { organizationLd } from '../lib/seo';
import { fill, pageHref, type LangCode } from '../lib/i18n';
import { trFor } from '../lib/i18n/loader';

/** The About page, in one language. */
interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const tt = trFor(lang);
const link = (href: string, text: string) => `<a class="link" href="${href}"${href.startsWith('http') ? ' rel="noopener"' : ''}>${text}</a>`;
const n = CALCULATORS.length;
const sections = [
  { h: tt('Who runs it'), p: fill(tt('iDuckCalculator is operated by Basic App Company. It is part of the iDuck family with {pdf}, {img} and {convert}, and it follows the same promises: no sign-up, no ads, and everything runs in your browser.'), { pdf: link('https://iduckpdf.com/', 'iDuckPDF'), img: link('https://iduckimg.com/', 'iDuckIMG'), convert: link('https://iduckconvert.com/', 'iDuckConvert') }) },
  { h: tt('What it costs'), p: tt('Using it costs nothing. The site is static files, so there is no server to run and no database. The only fixed cost is the domain name. Tips will be the only way to support it, and they are never required.') },
  { h: tt('How your numbers are handled'), p: fill(tt('Every calculation runs in your browser tab. The numbers you type are not sent anywhere and are not saved. The only things stored, in your own browser, are your theme and currency choices. Read the {privacy} for details.'), { privacy: link(pageHref(lang, '/privacy/'), tt('privacy page')) }) },
  { h: tt('How the maths is checked'), p: fill(tt('Each of the {n} calculators has an automatic test that compares its result with a known answer, such as an EMI of about ₹8,997 for a ₹10,00,000 loan at 9% over 20 years. Tax and savings-scheme rules are read from official sources, and the page shows the financial year and the date they were read. Results are estimates: lenders, banks and tax portals may round or apply extra charges.'), { n }) },
  { h: tt('Found a mistake?'), p: fill(tt('Please {tell}, with what you typed and what you expected.'), { tell: link(pageHref(lang, '/feedback/'), tt('tell us')) }) },
  { h: tt('How to contact us'), p: fill(tt('iDuckCalculator is a product of Basic App Company. For questions write to {email}, or use the {form} for a mistake or an idea. To see how results are tested and where the formulas come from, read {how}.'), { email: link(`mailto:${CONTACT_EMAIL}`, CONTACT_EMAIL), form: link(pageHref(lang, '/feedback/'), tt('feedback form')), how: link(pageHref(lang, '/how-we-check/'), tt('how we check our calculators')) }) },
];
const english = lang === 'en' || lang === 'en-gb';
---

<CommunityLayout
  title={tt('About iDuckCalculator: who runs it and how it works')}
  description={tt('iDuckCalculator is a free set of calculators from Basic App Company. See what it costs to run, how your numbers are handled and how the maths is checked.')}
  {...(english ? { before: tt('About'), mark: 'iDuckCalculator' } : { heading: tt('About iDuckCalculator') })}
  intro={tt('A small, friendly set of calculators that run in your browser, made by Basic App Company.')}
  jsonLd={[organizationLd()]}
>
  {
    sections.map((s) => (
      <section class="card p-5">
        <h2 class="text-2xl font-black tracking-tight">{s.h}</h2>
        <p class="mt-2" set:html={s.p} />
      </section>
    ))
  }
</CommunityLayout>
