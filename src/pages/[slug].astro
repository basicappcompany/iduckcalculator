---
import CalculatorPage from '../components/CalculatorPage.astro';
import { CALCULATORS } from '../lib/calc';

export function getStaticPaths() {
  return CALCULATORS.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}
const { slug } = Astro.props;
---

<CalculatorPage slug={slug} lang="en" />
