---
import AppShell from '../../components/AppShell.astro';
import { GUIDES, guideBySlug, guidePath } from '../../lib/guides';
import { calcBySlug, calcPath } from '../../lib/calc';
import TrustNote from '../../components/TrustNote.astro';
import { TRUST } from '../../lib/calc/sources';
import { articleLd, breadcrumbLd, faqLd, howToLd } from '../../lib/seo';

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { slug: g.slug } }));
}
const guide = guideBySlug(Astro.props.slug)!;
const path = guidePath(guide.slug);
const calcs = guide.calcs.map((s) => calcBySlug(s)!);
const others = guide.related.map((s) => guideBySlug(s)!);
// Finance and health guides carry the same review date, sources and estimate-only line as their calculators.
const trust = guide.calcs.map((s) => TRUST[s]).find(Boolean);
---

<AppShell
  title={`${guide.title} | iDuckCalculator`}
  description={guide.description}
  jsonLd={[
    articleLd({ headline: guide.title, description: guide.description, path, datePublished: guide.published, dateModified: guide.updated }),
    howToLd(guide.title, guide.steps),
    faqLd(guide.faqs),
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'How-to guides', path: '/guides/' }, { name: guide.title, path }]),
  ]}
>
  <p class="eyebrow"><a href="/guides/" class="underline decoration-2 underline-offset-2">How-to guides</a></p>
  <h1 class="display mt-2 text-3xl min-[400px]:text-4xl sm:text-5xl">{guide.title}</h1>
  <p class="mt-2 text-sm text-muted">Updated {guide.updated}</p>

  <section class="card mt-5 p-4" aria-label="Quick answer">
    <p class="eyebrow">Quick answer</p>
    <p class="mt-1 leading-relaxed">{guide.intro}</p>
  </section>

  <div class="prose mt-8">
    <h2>Steps</h2>
    <ol>
      {guide.steps.map((s) => <li>{s}</li>)}
    </ol>
    {
      guide.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
        </>
      ))
    }
  </div>

  {trust && <TrustNote trust={trust} reviewed={guide.updated} />}

  <section class="mt-10" aria-label="Try the calculators">
    <h2 class="text-2xl font-black tracking-tight">Try it yourself</h2>
    <ul class="mt-3 grid gap-4 sm:grid-cols-3">
      {
        calcs.map((c) => (
          <li>
            <a href={calcPath(c.slug)} class="card card-link h-full p-4">
              <span class="flex items-center gap-2 text-lg font-black"><span aria-hidden="true">{c.emoji}</span>{c.name}</span>
              <span class="mt-1 block text-sm text-muted">{c.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10" aria-label="Common questions">
    <h2 class="text-2xl font-black tracking-tight">Common questions</h2>
    <div class="mt-4 grid gap-3">
      {
        guide.faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {
    others.length > 0 && (
      <p class="mt-8 text-sm">
        Also read:{' '}
        {others.map((o, i) => (
          <>
            {i > 0 && ', '}
            <a class="link" href={guidePath(o.slug)}>{o.title}</a>
          </>
        ))}
      </p>
    )
  }
</AppShell>
