---
import CommunityLayout from '../../components/CommunityLayout.astro';
import { GUIDES, guidePath } from '../../lib/guides';
import { CALC_GROUPS, calcBySlug } from '../../lib/calc';
import { breadcrumbLd, collectionLd } from '../../lib/seo';
// A guide sits under the group of the first calculator it links to.
const sections = CALC_GROUPS.map((g) => ({ ...g, guides: GUIDES.filter((x) => calcBySlug(x.calcs[0]!)?.group === g.id) })).filter((g) => g.guides.length > 0);
---

<CommunityLayout
  title="How-to guides: loans, savings, dates, health and more | iDuckCalculator"
  description={`${GUIDES.length} short how-to guides with worked examples: EMI and loans, SIP and savings, percentages, dates, health and school. Each gives the answer first.`}
  before="How-to"
  mark="guides"
  intro="Short walkthroughs with worked examples. Each one gives the answer first, then shows the steps."
  jsonLd={[
    collectionLd('How-to guides', '/guides/', 'Worked examples and step-by-step guides.', GUIDES.map((g) => ({ name: g.title, path: guidePath(g.slug) }))),
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'How-to guides', path: '/guides/' }]),
  ]}
>
  {
    sections.map((s) => (
      <section class="mt-8 first:mt-0" aria-labelledby={`g-${s.id}`}>
        <h2 id={`g-${s.id}`} class="text-2xl font-black tracking-tight">{s.emoji} {s.name} <span class="text-base font-bold text-muted">({s.guides.length})</span></h2>
        <ul class="card-grid mt-3">
          {s.guides.map((g) => (
            <li>
              <a href={guidePath(g.slug)} class="card card-link h-full p-4">
                <span class="block text-[17px] font-black">{g.title}</span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{g.description}</span>
                <span class="mt-2 block text-xs text-muted">Updated {g.updated}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</CommunityLayout>
