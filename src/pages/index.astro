---
import AppShell from '../components/AppShell.astro';
import DuckMark from '../components/DuckMark.astro';
import { CALCULATORS, calcPath, calcsInGroup, liveGroups, popularCalcs } from '../lib/calc';
import { GUIDES, guideBySlug, guidePath } from '../lib/guides';
import { faqLd, organizationLd, websiteLd } from '../lib/seo';

const total = CALCULATORS.length;
const groups = liveGroups();

const faqs = [
  { q: 'What is iDuckCalculator?', a: `A free set of ${total} calculators for loans and EMI, savings and investing, everyday maths, dates, health and students. Everything runs in your browser.` },
  { q: 'Is iDuckCalculator free?', a: 'Yes. There is no sign-up and there are no ads. Support is by tips only, and it is never required.' },
  { q: 'Is my data sent to a server?', a: 'No. Every calculation happens in your browser tab, so the numbers you type never leave your device.' },
  { q: 'Are the results accurate?', a: 'The maths is tested against known answers. Real loans, investments and tax can differ because of fees, rounding and rule changes, so treat results as estimates and check with your lender or adviser.' },
  { q: 'Do I need to install anything?', a: 'No. Open a calculator in any modern browser, on a computer or a phone.' },
];

// Six guides on the home page; the rest are on the guides page.
const FEATURED_GUIDES = ['how-emi-is-calculated', 'sip-vs-lumpsum', 'how-to-calculate-percentage', 'how-to-calculate-your-age', 'how-to-calculate-bmi', 'how-to-convert-cgpa-to-percentage']
  .map(guideBySlug)
  .filter((g): g is NonNullable<typeof g> => !!g);

const why = [
  { emoji: '🔒', title: 'Your numbers stay with you', text: 'Every calculator runs in your browser. Nothing you type is sent to our servers.' },
  { emoji: '🎁', title: 'No account, no ads', text: 'Open a calculator and use it. Nothing to install, nothing in the way.' },
  { emoji: '📱', title: 'Made for phones too', text: 'Every calculator works at phone size, with results that update as you type.' },
];

const next = [
  { emoji: '🧾', title: 'Income tax, old vs new regime', text: 'Next up: side by side, from the official rules for the current financial year.' },
  { emoji: '🧮', title: 'Salary, HRA, gratuity, GST and TDS', text: 'Coming with the tax calculators, each showing the year and the date its rules were read.' },
  { emoji: '🏛️', title: 'PPF, Sukanya Samriddhi and NPS', text: 'Government scheme calculators, once the current rates and limits are checked.' },
];
---

<AppShell
  jsonLd={[websiteLd(), organizationLd(), faqLd(faqs)]}
  title="iDuckCalculator: free calculators that run in your browser"
  description="Free EMI, SIP, percentage, age, BMI and more calculators. No sign-up, no ads, and everything runs in your browser. Your numbers never leave your device."
>
  <section class="text-center">
    <DuckMark size={96} class="mx-auto" />
    <h1 class="display mt-4 text-4xl min-[420px]:text-5xl sm:text-6xl">Numbers, <span class="mark">quacked</span> open.</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
      {total} free calculators for loans, savings, everyday maths, dates, health and school. No sign-up, no ads, and everything runs in your browser tab.
    </p>
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      <span class="pill pill-ok">Runs in your browser</span>
      <span class="pill">No sign-up</span>
      <span class="pill">No ads</span>
    </div>

    <div class="mx-auto mt-6 max-w-xl">
      <button type="button" id="hero-search" class="hero-search" aria-label="Search calculators, pages and actions" data-open-palette>
        <span aria-hidden="true" class="text-lg">🔍</span>
        <span class="min-w-0 flex-1 truncate text-left">Search calculators…</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
      <p class="mt-2 text-sm text-muted" data-kbd-hint>Press <b>Ctrl K</b> (or <b>/</b>) on any page to search.</p>
    </div>
  </section>

  <section class="mt-8" aria-label="Ask the helper">
    <div class="card flex flex-wrap items-center gap-4 bg-duck p-5 text-duckink">
      <span aria-hidden="true" class="text-4xl">💬</span>
      <div class="min-w-48 flex-1">
        <h2 class="text-xl font-black tracking-tight">Not sure which calculator you need?</h2>
        <p class="opacity-80">Describe the job in plain words and the helper will point you to the right one.</p>
      </div>
      <a href="/chat/" class="btn btn-ink">Ask the helper</a>
    </div>
  </section>

  <section class="mt-10" aria-label="Popular right now">
    <h2 class="text-2xl font-black tracking-tight">Popular right now</h2>
    <ul class="card-grid mt-3">
      {
        popularCalcs().map((c) => (
          <li>
            <a href={calcPath(c.slug)} class="card card-link h-full p-4">
              <span class="flex items-center gap-2.5 text-[17px] font-black">
                <span aria-hidden="true" class="text-[28px] leading-none">{c.emoji}</span>
                {c.name}
              </span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{c.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" aria-label="All calculators">
    <h2 class="text-2xl font-black tracking-tight">All {total} calculators</h2>
    <p class="mt-1 text-muted">Pick a group to narrow the list, or press Ctrl K to search.</p>
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter by group">
      <button type="button" class="chip" role="switch" aria-checked="true" data-filter="all">Everything ({total})</button>
      {
        groups.map((g) => (
          <button type="button" class="chip" role="switch" aria-checked="false" data-filter={g.id}>
            {g.emoji} {g.name} ({calcsInGroup(g.id).length})
          </button>
        ))
      }
    </div>
    <div class="mt-6">
      {
        groups.map((g) => (
          <div class="mt-8 first:mt-0" data-card-group data-group={g.id}>
            <h3 class="text-2xl font-black tracking-tight">{g.emoji} {g.name}</h3>
            <ul class="card-grid mt-3">
              {calcsInGroup(g.id).map((c) => (
                <li data-card data-slug={c.slug}>
                  <a href={calcPath(c.slug)} class="card card-link h-full p-4">
                    <span class="flex items-center gap-2.5 text-[17px] font-black">
                      <span aria-hidden="true" class="text-[28px] leading-none">{c.emoji}</span>
                      {c.name}
                    </span>
                    <span class="mt-1 block text-sm leading-[19px] text-muted">{c.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-14" aria-label="New and next">
    <h2 class="text-3xl font-black tracking-tight">New and next</h2>
    <p class="mt-1 text-muted">What we are building next. Tax and scheme rules are checked against official sources before any calculator goes live.</p>
    <ul class="card-grid mt-3">
      {
        next.map((item) => (
          <li class="card p-4">
            <span class="flex items-center gap-2.5 text-[17px] font-black">
              <span aria-hidden="true" class="text-[28px] leading-none">{item.emoji}</span>
              {item.title}
            </span>
            <span class="mt-1 block text-sm leading-[19px] text-muted">{item.text}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm"><a class="link" href="/roadmap/">See the full roadmap</a> or <a class="link" href="/request/">request a calculator</a>.</p>
  </section>

  <section class="mt-14" aria-label="Why iDuckCalculator">
    <ul class="grid gap-4 sm:grid-cols-3">
      {
        why.map((item) => (
          <li class="card p-4">
            <span aria-hidden="true" class="text-[28px] leading-none">{item.emoji}</span>
            <h3 class="mt-2 text-lg font-black">{item.title}</h3>
            <p class="mt-1 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14" aria-label="How-to guides">
    <h2 class="text-3xl font-black tracking-tight">How-to guides</h2>
    <p class="mt-1 text-muted">Short walkthroughs with worked examples. Each gives the answer first.</p>
    <ul class="card-grid mt-3">
      {
        FEATURED_GUIDES.map((g) => (
          <li>
            <a href={guidePath(g.slug)} class="card card-link h-full p-4">
              <span class="block text-[17px] font-black">{g.title}</span>
              <span class="mt-1 block text-sm leading-[19px] text-muted">{g.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3"><a class="link" href="/guides/">All {GUIDES.length} how-to guides</a></p>
  </section>

  <section class="mt-14" aria-label="Common questions">
    <h2 class="text-3xl font-black tracking-tight">Common questions</h2>
    <div class="mt-4 grid gap-3">
      {
        faqs.map((f) => (
          <details class="card px-4 py-3">
            <summary class="cursor-pointer text-lg font-black">{f.q}</summary>
            <p class="mt-2 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mt-14" aria-label="Support">
    <div class="card flex flex-wrap items-center gap-4 p-5">
      <span aria-hidden="true" class="text-4xl">💛</span>
      <div class="min-w-48 flex-1">
        <h2 class="text-xl font-black tracking-tight">Keep it free</h2>
        <p class="text-muted">No ads, no sign-up. Sharing it with a friend helps most.</p>
      </div>
      <a href="/support/" class="btn btn-primary">Support iDuckCalculator</a>
    </div>
  </section>

  <script>
    // The big search box is a button for the Ctrl K window, which lives in the page shell.
    document.querySelectorAll('[data-open-palette]').forEach((el) => el.addEventListener('click', () => document.getElementById('search-open')?.click()));

    // Group chips narrow the list of calculators; "Everything" shows all of them again.
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const wanted = chip.dataset['filter'] ?? 'all';
        chips.forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
        document.querySelectorAll<HTMLElement>('[data-card-group]').forEach((g) => {
          g.hidden = wanted !== 'all' && g.dataset['group'] !== wanted;
        });
      }),
    );
  </script>
</AppShell>
