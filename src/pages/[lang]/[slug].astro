---
import CalculatorPage from '../../components/CalculatorPage.astro';
import { CALCULATORS } from '../../lib/calc';
import { DEFAULT_LANG, LANGUAGES, isLang } from '../../lib/i18n';

/** Every calculator in every language except English, which is src/pages/[slug].astro. */
export function getStaticPaths() {
  return LANGUAGES.filter((l) => l.code !== DEFAULT_LANG).flatMap((l) => CALCULATORS.map((c) => ({ params: { lang: l.code, slug: c.slug }, props: { slug: c.slug } })));
}
const { lang } = Astro.params;
const { slug } = Astro.props;
if (!isLang(lang)) throw new Error(`Unknown language: ${lang}`);
---

<CalculatorPage slug={slug} lang={lang} />
