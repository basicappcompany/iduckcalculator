---
import HomePage from '../../components/HomePage.astro';
import { DEFAULT_LANG, isLang, langsFor } from '../../lib/i18n';

/** The home page in every language except English, which is src/pages/index.astro. */
export function getStaticPaths() {
  return langsFor('/')
    .filter((lang) => lang !== DEFAULT_LANG)
    .map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`Unknown language: ${lang}`);
---

<HomePage lang={lang} />
