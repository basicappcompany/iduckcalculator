---
import AppShell from '../components/AppShell.astro';
import { CALCULATORS, calcPath, calcsInGroup, liveGroups } from '../lib/calc';
import { breadcrumbLd, collectionLd } from '../lib/seo';

const groups = liveGroups();
const items = CALCULATORS.map((c) => ({ name: c.name, path: calcPath(c.slug) }));
---

<AppShell
  title="All calculators: loans, savings, maths, dates, health | iDuckCalculator"
  description={`Browse all ${CALCULATORS.length} free calculators: EMI and loans, SIP and savings, percentage and everyday maths, dates, health and student tools.`}
  jsonLd={[collectionLd('All calculators', '/calculators/', 'Every free calculator on iDuckCalculator.', items), breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'All calculators', path: '/calculators/' }])]}
>
  <h1 class="display text-4xl sm:text-5xl">All <span class="mark">{CALCULATORS.length}</span> calculators</h1>
  <p class="mt-3 max-w-2xl text-lg text-muted">Every calculator, by group. Results update as you type, and nothing leaves your browser.</p>
  <nav class="mt-5 flex flex-wrap gap-2" aria-label="Jump to a group">
    {groups.map((g) => <a class="chip" href={`#${g.id}`}>{g.emoji} {g.name}</a>)}
  </nav>
  {
    groups.map((g) => (
      <section class="mt-10" id={g.id} aria-label={g.name}>
        <h2 class="text-2xl font-black tracking-tight">{g.emoji} {g.name}</h2>
        <ul class="card-grid mt-3">
          {calcsInGroup(g.id).map((c) => (
            <li>
              <a href={calcPath(c.slug)} class="card card-link h-full p-4">
                <span class="flex items-center gap-2.5 text-[17px] font-black">
                  <span aria-hidden="true" class="text-[28px] leading-none">{c.emoji}</span>
                  {c.name}
                </span>
                <span class="mt-1 block text-sm leading-[19px] text-muted">{c.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</AppShell>
