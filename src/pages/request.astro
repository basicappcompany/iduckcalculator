---
import CommunityLayout from '../components/CommunityLayout.astro';
import FeedbackForm from '../components/FeedbackForm';
---

<CommunityLayout
  title="Request a calculator | iDuckCalculator"
  description="Tell us about a calculator or improvement you would like to see on iDuckCalculator."
  before="Got an"
  mark="idea"
  after="?"
  intro="Describe a new calculator, or a way an existing one could work better, with a real example if you can. Your ideas shape what comes next."
  noindex
>
  <FeedbackForm mode="request" client:load />
  <p class="text-sm text-muted">You can also look at the <a class="link" href="/roadmap/">roadmap</a> to see what is already on our list.</p>
</CommunityLayout>
